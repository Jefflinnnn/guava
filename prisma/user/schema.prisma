// Schema for each user's OWN Neon database (their workspace). The app
// database (prisma/schema.prisma) holds auth and a pointer to this one.
//
// Not managed by `prisma migrate`: guava applies lib/user-db/migrations to
// every workspace itself, on connect and on the next visit after a deploy.
// After editing this file, run `pnpm user-db:migration <name>`.

generator client {
  provider = "prisma-client"
  output   = "../../generated/user-prisma"
}

datasource db {
  provider = "postgresql"
}

// Single row (id = 1): preferences from the Settings page and the
// dashboard layout.
model Settings {
  id                  Int      @id @default(1)
  autoCategorizeBills Boolean  @default(true)
  weeklyReminder      Boolean  @default(true)
  bigPurchaseAlert    Boolean  @default(false)
  // Dashboard widgets in display order: [{ id, size }].
  widgets             Json     @default("[]")
  updatedAt           DateTime @updatedAt
}

// A spending category.
model Category {
  id        String        @id @default(cuid())
  name      String        @unique @db.VarChar(24)
  // Any CSS color: an oklch() preset or a #hex custom pick.
  color     String        @db.VarChar(64)
  // Locked categories can't be edited or deleted until unlocked.
  locked    Boolean       @default(false)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  subs      Subcategory[]
  // Deleting a category leaves its expenses uncategorized.
  expenses  Expense[]
}

model Subcategory {
  id         String    @id @default(cuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(24)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expenses   Expense[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

// One spend, entered by hand for now. Bank imports (Plaid) add their own
// columns later. Amounts are positive; refunds and income come later.
// No category means uncategorized; those always need review.
model Expense {
  id                 String       @id @default(cuid())
  // A calendar day with no time zone, read and written as YYYY-MM-DD.
  date               DateTime     @db.Date
  name               String       @db.VarChar(40)
  amountCents        Int
  categoryId         String?
  category           Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId      String?
  subcategory        Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  needsReview        Boolean      @default(true)
  note               String       @default("") @db.VarChar(200)
  // False for money that isn't spending (card payments, transfers, income):
  // listed so the user sees every bank transaction, but left out of totals.
  spending           Boolean      @default(true)
  // Plaid's detailed category (e.g. LOAN_PAYMENTS_CREDIT_CARD_PAYMENT) for
  // imported expenses; null when entered by hand.
  bankCategory       String?      @db.VarChar(64)
  // Set on expenses imported from a bank through Plaid; null when entered by
  // hand. Unique, so syncing twice never duplicates a transaction.
  plaidTransactionId String?      @unique
  bankAccountId      String?
  bankAccount        BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  // Set while the expense is in Recently deleted: hidden everywhere, and
  // deleted for good 30 days later (see lib/guava/server/trash.ts).
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([date])
  @@index([needsReview])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([bankAccountId])
  @@index([deletedAt])
}

// The user's own Plaid API keys (bring your own key). One row, or none when
// bank syncing isn't set up. Plaid is optional: without this row guava is a
// manual expense tracker.
model PlaidConfig {
  id        Int      @id @default(1)
  clientId  String   @db.VarChar(64)
  // Encrypted with ENCRYPTION_KEY (see lib/crypto.ts). Never sent to the browser.
  secret    String
  // "sandbox" or "production".
  env       String   @db.VarChar(16)
  updatedAt DateTime @updatedAt
}

// A bank login linked through Plaid Link (a Plaid "Item").
model PlaidItem {
  id              String        @id @default(cuid())
  plaidItemId     String        @unique
  // Encrypted with ENCRYPTION_KEY (see lib/crypto.ts). Never sent to the browser.
  accessToken     String
  institutionName String?
  // Position in /transactions/sync, so each sync only pulls what changed.
  cursor          String?
  lastSyncedAt    DateTime?
  // Set when the bank asks the user to sign in again (Plaid's
  // ITEM_LOGIN_REQUIRED); syncing stops until they reconnect.
  loginRequired   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accounts        BankAccount[]
}

// One account (checking, credit card, ...) under a PlaidItem. Kept when its
// bank is disconnected (itemId becomes null), so imported expenses still show
// which bank and card they came from.
model BankAccount {
  id              String     @id @default(cuid())
  itemId          String?
  item            PlaidItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  // Copied from the PlaidItem, since the item is gone after a disconnect.
  institutionName String?
  plaidAccountId  String     @unique
  // The bank's name for the account, e.g. "Credit Card".
  name            String
  // The user's own name for it, e.g. "Chase Freedom"; shown instead of
  // `name` when set. Syncing never changes it.
  nickname        String?    @db.VarChar(40)
  // Last 4 digits of the account or card number.
  mask            String?
  type            String
  subtype         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  expenses        Expense[]

  @@index([itemId])
}

// Bank transactions deleted for good (after 30 days in Recently deleted), so
// syncing doesn't import them again (Plaid resends a transaction when it
// changes, and a pending charge comes back under a new id once it posts).
model DeletedBankTransaction {
  plaidTransactionId String   @id
  createdAt          DateTime @default(now())
  // Deleted before Recently deleted existed: the next sync brings it back
  // into Recently deleted (and drops this row) instead of skipping it.
  restorable         Boolean  @default(false)
}
