// Prisma schema. Docs: https://pris.ly/d/prisma-schema
// Connection URLs live in prisma.config.ts (CLI) and lib/prisma.ts (app).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth (Better Auth, see lib/auth.ts) ---
// User, Session, AuthAccount and Verification follow Better Auth's core
// schema. Field names must match it; add app-specific fields freely.

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  authAccounts  AuthAccount[]
  workspace     Workspace?
  plaidItems    PlaidItem[]
}

// One signed-in browser. The session cookie holds `token`.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// A login method for a user, e.g. "credential" (email + password hash).
// Better Auth calls this model "account"; it's renamed here (see
// lib/auth.ts) so it doesn't collide with the Plaid bank Account below.
model AuthAccount {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// --- Workspace ---

// Where a user's own data lives: their Neon database (see
// prisma/user/schema.prisma). Every signed-in user needs one before using
// the app. This is the only user secret the app database holds.
model Workspace {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Encrypted with ENCRYPTION_KEY (see lib/crypto.ts). Never sent to the browser.
  neonUrl       String
  // Display details from the last successful connection test.
  database      String
  region        String
  pgVersion     Int
  // Name of the last lib/user-db migration applied to this database.
  schemaVersion String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- Plaid ---

// One row per bank connection ("Item" in Plaid terms).
model PlaidItem {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId        String    @unique
  // Encrypted with ENCRYPTION_KEY (see lib/crypto.ts). Never send to the browser.
  accessToken        String
  institutionId      String?
  institutionName    String?
  // Cursor for /transactions/sync, so each sync only pulls what changed.
  transactionsCursor String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  accounts           Account[]

  @@index([userId])
}

model Account {
  id             String    @id @default(cuid())
  plaidItemId    String
  item           PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidAccountId String    @unique
  name           String
  mask           String?
  type           String
  subtype        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([plaidItemId])
}
