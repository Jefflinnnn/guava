# Copy to .env and fill in. Never commit .env.

# --- Neon (console.neon.tech → your project → Connect) ---
# Pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (same, without "-pooler"). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Plaid (dashboard.plaid.com → Developers → Keys) ---
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# sandbox | production
PLAID_ENV="sandbox"
# Comma-separated Plaid products to request in Link.
PLAID_PRODUCTS="transactions"
PLAID_COUNTRY_CODES="US"
# Optional: public URL Plaid should send webhooks to (e.g. an ngrok URL in dev).
PLAID_WEBHOOK_URL=""

# --- Encryption for stored Plaid access tokens ---
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
