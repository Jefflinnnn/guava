# Copy to .env and fill in. Never commit .env.
#
# These configure the APP: one shared database for logins, plus the keys
# below. Each user's own data lives in a Neon database they connect inside
# the app; those connection strings never go in env vars.
#
# On Vercel, set these by hand (Project → Settings → Environment Variables).
# Don't connect a Neon or Prisma storage integration: they add their own
# DATABASE_URL and friends, which then can't be edited.

# --- App database (Neon: console.neon.tech → project → Connect) ---
# Holds logins and sessions (Better Auth) and, per user, an encrypted pointer
# to their own database. Run `pnpm db:deploy` against it after pulling new
# migrations.
# Pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (same, without "-pooler"). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth (login / sign up) ---
# Signs session cookies and tokens. 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# The app's public URL, without a trailing slash: http://localhost:3000 locally,
# the production domain on Vercel.
BETTER_AUTH_URL="http://localhost:3000"

# --- Encryption for secrets stored in the app database ---
# Encrypts users' database connection strings and Plaid keys and tokens.
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it once data is stored: saved secrets can't be decrypted with
# a new key. Every environment that shares an app database must use the same
# value.
ENCRYPTION_KEY=""

# --- Plaid ---
# None. Plaid is bring-your-own-key: each user saves their own client ID and
# secret on the Integrations page, stored encrypted in their own database.
